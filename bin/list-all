#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

if [[ "$(uname)" == "Darwin" ]]; then
  ostype="macos"
elif [[ "$(uname)" == "Linux" ]]; then
  ostype="linux"
fi

list_os_versions() {
    list_all_versions |
    grep $ostype |
    grep -oE '^kof-[0-9]+\.[0-9]+\.[0-9]+-\w+-linux' |
    grep -oE '[0-9]+\.[0-9]+\.[0-9]+' |
    sort_versions |
    xargs echo
}

list_os_versions